# build artifacts / binaries (keep these OUT of git)
*.exe
*.o
/dist/

# PMM tool packages & big upstream files (outside mirror/packages)
*.pdm
*.msi
*.tar.xz
*.tar.gz
*.zip

# mirror runtime logs
**/mirror/server.log

# editors
.vscode/
.idea/

# tool workspace cache
.zcode/

# The mirror registry is committed so the mirror is complete and downloadable.
# Un-ignore the registry metadata (dists/) and the .pdm payloads (files/*/*).
# (*.pdm elsewhere stays ignored). Uses ** so it still matches after relocation.
!**/mirror/dists/
!**/mirror/dists/**
!**/mirror/files/
!**/mirror/files/**/*.pdm

# installer downloads served at /downloads/ (committed so the site works)
!web/downloads/
!web/downloads/**/*.zip
!web/downloads/**/*.deb
!web/downloads/**/*.exe

# source browser cache clone
web/.src/
web/git/
web/releases/

# pmu upload service runtime state (accounts / sessions)
web/pmu/data/*.json
web/pmu/data/*.tmp
